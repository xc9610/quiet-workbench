{
  "name": "quiet-workbench",
  "version": "0.8.19",
  "private": true,
  "description": "A local-first, modular personal workspace for Obsidian.",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings=0",
    "verify": "pnpm run check && pnpm run test && pnpm run lint && pnpm run build",
    "release:check": "node scripts/release-check.mjs",
    "release:verify": "pnpm run verify && pnpm run release:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.17.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.8.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "obsidian": "^1.13.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
