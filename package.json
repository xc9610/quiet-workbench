{
  "name": "quiet-workbench",
  "version": "0.6.0",
  "private": true,
  "description": "A local-first project, task, meeting and knowledge workbench for Obsidian.",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings=0",
    "verify": "pnpm run check && pnpm run test && pnpm run lint && pnpm run build",
    "release:check": "node scripts/release-check.mjs",
    "release:verify": "pnpm run verify && pnpm run release:check"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^22.17.0",
    "esbuild": "latest",
    "esbuild-svelte": "latest",
    "eslint": "latest",
    "eslint-plugin-obsidianmd": "latest",
    "globals": "latest",
    "obsidian": "latest",
    "svelte": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
